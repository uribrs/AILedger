{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AILedger record_claim_dispositions v1 response",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "status": {
          "const": "committed"
        },
        "replayed": {
          "type": "boolean"
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        }
      },
      "required": [
        "schema_version",
        "attempt_id",
        "status",
        "replayed",
        "receipt"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "invalid_reference",
                "authorization_denied",
                "kernel_refused",
                "idempotency_conflict",
                "task_not_found",
                "capacity_exceeded",
                "storage_unavailable",
                "outcome_unknown",
                "history_corrupt",
                "state_conflict"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "boundary": {
              "enum": [
                "request",
                "binding",
                "application",
                "kernel",
                "storage"
              ]
            },
            "commit_state": {
              "enum": [
                "not_committed",
                "committed",
                "unknown"
              ]
            },
            "retry": {
              "enum": [
                "same_request",
                "after_correction",
                "none"
              ]
            },
            "item_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "rule_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "code",
            "message",
            "boundary",
            "commit_state",
            "retry",
            "item_path",
            "rule_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "attempt_id",
        "status",
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "receipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "transaction_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "causation_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "payload_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fingerprint_algorithm": {
          "const": "claim_dispositions-v1-c14n1"
        },
        "committed_at": {
          "type": "string",
          "format": "date-time"
        },
        "ledger_version": {
          "type": "integer",
          "minimum": 1
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "claim_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "previous_status": {
                "enum": [
                  "open",
                  "validated"
                ]
              },
              "status": {
                "enum": [
                  "validated",
                  "rejected"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "evidence_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "evidence_id"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 32
              },
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "enum": [
                        "decision",
                        "work_item"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "enum": [
                        "invalidated",
                        "stale",
                        "blocked"
                      ]
                    }
                  },
                  "required": [
                    "event_id",
                    "kind",
                    "id",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "key",
              "claim_id",
              "previous_status",
              "status",
              "rationale",
              "evidence",
              "event_id",
              "dependencies"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "transaction_id",
        "task_id",
        "actor_id",
        "run_id",
        "correlation_id",
        "causation_id",
        "payload_fingerprint",
        "fingerprint_algorithm",
        "committed_at",
        "ledger_version",
        "event_ids",
        "dispositions"
      ],
      "additionalProperties": false
    }
  }
}
