{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "area_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "expected_binding": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "partial",
        "complete",
        "blocked",
        "unknown"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "inspected_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 32,
      "minItems": 0
    },
    "read_receipts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 32,
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not_checked"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "test_receipts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "maxItems": 32,
            "minItems": 0
          }
        },
        "required": [
          "criterion_id",
          "status",
          "evidence",
          "test_receipts"
        ]
      },
      "maxItems": 32,
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "defect",
              "contradiction",
              "ambiguity"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "maxItems": 32,
            "minItems": 0
          },
          "contradicts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "maxItems": 32,
            "minItems": 0
          },
          "requirement_ids": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "uniqueItems": true
          },
          "uncertainty": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "uniqueItems": true
          }
        },
        "required": [
          "key",
          "kind",
          "statement",
          "paths",
          "contradicts"
        ]
      },
      "maxItems": 32,
      "minItems": 0
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 32,
      "minItems": 0
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "finding_judgments": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1
          },
          "finding_id": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "upheld",
              "refuted",
              "not_applicable",
              "repaired"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "uniqueItems": true
          },
          "uncertainty": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "source_trace",
                    "reproduction"
                  ]
                },
                "receipt_id": {
                  "type": "string"
                },
                "path_or_check_id": {
                  "type": "string"
                },
                "observation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "required": [
                "kind",
                "receipt_id",
                "path_or_check_id",
                "observation"
              ]
            }
          }
        },
        "required": [
          "schema_version",
          "finding_id",
          "decision",
          "rationale",
          "requirement_ids",
          "uncertainty",
          "evidence"
        ]
      }
    },
    "repair_impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "before_receipt": {
          "type": "string",
          "minLength": 1
        },
        "dependency_rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "affected_areas": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "requirement_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "dependency_areas": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required_checks": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "addressed_findings": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "reuse_receipts": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "invalidate_receipts": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "uncertainty": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "impact_read_receipts": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "schema_version",
        "before_receipt",
        "dependency_rationale",
        "affected_areas",
        "requirement_ids",
        "dependency_areas",
        "required_checks",
        "addressed_findings",
        "reuse_receipts",
        "invalidate_receipts",
        "uncertainty",
        "impact_read_receipts"
      ]
    }
  },
  "required": [
    "schema_version",
    "area_id",
    "request_id",
    "expected_binding",
    "status",
    "summary",
    "inspected_paths",
    "read_receipts",
    "checks",
    "findings",
    "uncertainty"
  ]
}
