{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "area_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "expected_binding": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "partial",
        "complete",
        "blocked",
        "unknown"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "inspected_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 32,
      "minItems": 0
    },
    "read_receipts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 32,
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not_checked"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "test_receipts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "maxItems": 32,
            "minItems": 0
          }
        },
        "required": [
          "criterion_id",
          "status",
          "evidence",
          "test_receipts"
        ]
      },
      "maxItems": 32,
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "defect",
              "contradiction",
              "ambiguity"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "maxItems": 32,
            "minItems": 0
          },
          "contradicts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "maxItems": 32,
            "minItems": 0
          }
        },
        "required": [
          "key",
          "kind",
          "statement",
          "paths",
          "contradicts"
        ]
      },
      "maxItems": 32,
      "minItems": 0
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 32,
      "minItems": 0
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "area_id",
    "request_id",
    "expected_binding",
    "status",
    "summary",
    "inspected_paths",
    "read_receipts",
    "checks",
    "findings",
    "uncertainty"
  ]
}
