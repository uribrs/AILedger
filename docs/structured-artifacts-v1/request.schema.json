{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AILedger submit_artifact v1 request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "kind": {
      "enum": [
        "verifier-output",
        "code-review-output"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 131072
    },
    "expected_content_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "supersedes_artifact_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "kind",
    "title",
    "content"
  ],
  "additionalProperties": false
}
