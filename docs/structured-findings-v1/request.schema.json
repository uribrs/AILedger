{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "consequence_if_wrong": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 8192
          },
          "from_lesson": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "key",
          "statement"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "source_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "citation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "supports": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "finding": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                    }
                  },
                  "required": [
                    "finding"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "claim_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "claim_id"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 0,
            "maxItems": 64
          },
          "refutes": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "finding": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                    }
                  },
                  "required": [
                    "finding"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "claim_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "claim_id"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 0,
            "maxItems": 64
          }
        },
        "required": [
          "key",
          "source_type",
          "citation",
          "summary",
          "supports",
          "refutes"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "findings",
    "evidence"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "findings": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "evidence": {
          "minItems": 1
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AILedger record_findings v1 request",
  "$comment": "Duplicate property rejection, valid Unicode scalars, nonblank text, total reference/body limits and domain rules are additional application/transport checks; see ../structured-findings-v1.md."
}
