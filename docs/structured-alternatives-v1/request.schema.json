{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "from_lesson": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "rejection_rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "replaced_by_decision_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "key",
          "statement",
          "rejection_rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "alternatives"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AILedger record_alternatives v1 request",
  "$comment": "Duplicate property rejection, valid Unicode scalars, nonblank text, body limits and domain rules are additional application/transport checks; see ../structured-alternatives-v1.md."
}
