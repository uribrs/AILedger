<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- The assembly is also the probe process RefusalJournalTests spawns to prove that two
         operating-system processes writing one refusal journal both land a complete row. That needs
         an entry point, so the test SDK's generated empty one is replaced by Program.cs. The test
         runners load the assembly and never call Main, so nothing else changes. -->
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AILedger.Core\AILedger.Core.csproj" />
    <ProjectReference Include="..\..\src\AILedger.Storage\AILedger.Storage.csproj" />
    <ProjectReference Include="..\..\src\AILedger.Providers\AILedger.Providers.csproj" />
    <ProjectReference Include="..\..\src\AILedger.Cli\AILedger.Cli.csproj" />
  </ItemGroup>

</Project>
